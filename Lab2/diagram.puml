@startuml
left to right direction
skinparam packageStyle rectangle

actor "Гість" as Guest
actor "Авторизований Клієнт" as Client
actor "Менеджер філії" as Manager

Guest <|-- Client

package "Система оренди автомобілів" {
    usecase "UC-1: Пошук та фільтрація авто" as UC1
    usecase "UC-2: Створення бронювання" as UC2
    usecase "UC-3: Оплата оренди" as UC3
    usecase "UC-4: Застосування промокоду" as UC4
    usecase "UC-5: Скасування бронювання" as UC5
    usecase "UC-6: Обробка видачі/повернення авто" as UC6
    usecase "UC-7: Автоматичне зняття броні" as UC7
}

Guest --> UC1
Client --> UC2
Client --> UC5
Manager --> UC6
UC7 -.-> UC2

UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<extend>>
@enduml